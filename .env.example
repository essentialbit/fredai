# FredAI — Environment Configuration Template
# Copy this to .env and fill in your values:
#   cp .env.example .env

# ── X / TWITTER API ──────────────────────────────────────────────────────────
# Get credentials at: https://developer.twitter.com
X_BEARER_TOKEN=your_x_bearer_token_here
X_CONSUMER_KEY=your_consumer_key_here
X_CONSUMER_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# ── AI PROVIDER ───────────────────────────────────────────────────────────────
# NOTE: Claude Pro (claude.ai) subscriptions are web-UI only — cannot be used
# by third-party apps. Use one of the API keys below, or free local Ollama.
#
# Option A — Anthropic API (pay-per-token, ~$0.25/1M tokens on Haiku, best quality):
ANTHROPIC_API_KEY=your_anthropic_api_key_here
#
# Option B — Google Gemini (free tier available, rate-limited): https://aistudio.google.com
GEMINI_API_KEY=
#
# Option C — xAI Grok (pay-per-token, frontier-quality): https://console.x.ai
XAI_API_KEY=
#
# Option D — Groq (free, cloud-hosted, no cost): https://console.groq.com
GROQ_API_KEY=
#
# Option E — Ollama free local inference (no API cost, fully on-device):
#   Install: https://ollama.com  then: ollama pull llama3.2
#   Set: AI_PROVIDER=ollama
#
# Optional — Tavily live-search grounding (works with any provider above):
# https://tavily.com — free tier, 1,000 credits/month
TAVILY_API_KEY=
#
# AI_PROVIDER picks the routing strategy, not a specific key:
#   auto (default) → Anthropic, else Gemini, else Grok, else Groq, else Ollama, else degraded
#   anthropic | gemini | grok | groq | ollama → force that one provider
AI_PROVIDER=auto

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Advanced — per-tier model overrides (optional; sane defaults already set).
# Each provider routes a cheap/fast model to high-frequency summaries, a
# stronger one to user-facing chat, and its best to the R&D agent:
#   ANTHROPIC_MODEL_SUMMARY / ANTHROPIC_MODEL_CHAT / ANTHROPIC_MODEL_RND
#   GEMINI_MODEL_SUMMARY / GEMINI_MODEL_CHAT / GEMINI_MODEL_RND
#   GROQ_MODEL_SUMMARY / GROQ_MODEL_CHAT / GROQ_MODEL_RND
#   XAI_MODEL_SUMMARY / XAI_MODEL_CHAT / XAI_MODEL_RND

# ── NASDAQ DATA LINK (optional — free tier works without key) ─────────────────
NASDAQ_API_KEY=

# ── PRIVACY ──────────────────────────────────────────────────────────────────
PRIVACY_MODE=true
STRIP_PORTFOLIO_FROM_AI=true
DATA_RETENTION_DAYS=90
# News is fetched every 30min and drives near-term decisions, so it gets its
# own much shorter retention window than the general DATA_RETENTION_DAYS above.
NEWS_RETENTION_HOURS=72

# ── APP ───────────────────────────────────────────────────────────────────────
# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_64char_hex_string
PORT=8080

# Set to true once you're running behind HTTPS (reverse proxy, Cloudflare
# Tunnel, etc.) — keeps session cookies from ever being sent over plain HTTP.
# Leave false for local/LAN self-hosting without TLS.
SESSION_COOKIE_SECURE=false

# ── SECURITY ──────────────────────────────────────────────────────────────────
# Initial admin password — only used when the DB is first created (no users exist).
# After first run, change via the UI or remove this line (it has no effect once admin exists).
# If unset, a random password is generated and printed to the console ONCE.
FREDAI_ADMIN_PASSWORD=

# Deploy secret — required for CI webhook to push updates to this instance.
# Must match FREDAI_DEPLOY_SECRET in your GitHub repository's Actions Secrets.
# If unset, CI-push updates are disabled (updates still work via 6h poll or manual UI).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FREDAI_DEPLOY_SECRET=

# ── COMMUNITY ENGAGEMENT ─────────────────────────────────────────────────────
# Fred monitors GitHub Issues, Discussions, and PRs every 6h and responds
# to productive interactions automatically using Claude.
#
# GITHUB_TOKEN: fine-grained PAT with Issues + Discussions + Pull Requests (read+write)
# Generate at: github.com/settings/tokens → Fine-grained tokens
# In GitHub Actions CI this is provided automatically — no action needed for CI.
# Only needed here if you want community engagement from a locally-running Fred.
GITHUB_TOKEN=
GITHUB_REPO=essentialbit/fredai

# ── OAUTH LOGIN (optional — "Sign in with Google" / "Sign in with GitHub") ────
# Separate from GITHUB_TOKEN above: these are OAuth app credentials that let
# your users log in to Fred with their own Google/GitHub account, not a PAT.
# Google: create credentials at console.cloud.google.com → APIs & Services → Credentials
# GitHub: create an OAuth App at github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── ADVANCED TUNING (optional — sane defaults already set) ───────────────────
# Calibration Engine (FSI L4): weight each source's confluence-score
# contribution by its Brier-derived reliability. Set false to instantly
# revert to unweighted scoring if calibration data ever looks wrong.
CALIBRATION_WEIGHTS_ENABLED=true
# Research Desk (FSI L4): estimated token budget per Bull/Bear/Risk/PM
# committee run (see market_debate.py).
COMMITTEE_MAX_TOKENS=6000

# ── AUTO-UPDATE ───────────────────────────────────────────────────────────────
# notify = show badge when update available (default)
# auto   = pull and apply updates silently every 6h
# off    = never check for updates
AUTO_UPDATE=notify
